{
  "name": "drift-drive",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:start": "npm run desktop:prepare && electron .",
    "desktop:pack": "npm run desktop:prepare && electron-builder --dir --publish never",
    "desktop:mac": "npm run desktop:prepare && electron-builder --mac --publish never",
    "desktop:win": "npm run desktop:prepare && electron-builder --win --x64 --publish never",
    "desktop:check": "node --test tests/desktop.test.mjs"
  },
  "devDependencies": {
    "clipper-lib": "^6.4.2",
    "electron": "43.8.8",
    "electron-builder": "26.18.0",
    "sharp": "0.34.5",
    "three": "0.160.0"
  },
  "version": "5.2.0",
  "description": "Drift Drive \u2014 Cruise Life, a Japanese-inspired arcade driving game",
  "author": {
    "name": "Marvyn De Sousa"
  },
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.18.0"
  }
}
